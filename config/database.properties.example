# MySQL connection settings for Paradox.
# Copy this file to config/database.properties (already gitignored) and adjust
# the values for your machine. Never commit the real file.

# Environment variables PARADOX_DB_URL, PARADOX_DB_USER and PARADOX_DB_PASSWORD
# override the values in this file if they are set.
db.url=jdbc:mysql://localhost:3306/paradox_db
db.user=root
db.password=your-mysql-password
