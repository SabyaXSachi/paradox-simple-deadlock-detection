<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.paradox.SimulationController"
            prefWidth="1020" prefHeight="700">

    <top>
        <HBox styleClass="header" spacing="10" alignment="CENTER_LEFT">
            <padding>
                <Insets top="10" right="16" bottom="10" left="16"/>
            </padding>
            <VBox spacing="0">
                <Label text="PARADOX" styleClass="app-title"/>
                <Label text="Simple Deadlock Detection System" styleClass="app-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Simulation:"/>
            <TextField fx:id="simulationNameField" promptText="new simulation name" prefWidth="170"/>
            <Button text="Create" onAction="#createSimulation"/>
            <ComboBox fx:id="simulationCombo" prefWidth="190"/>
            <Button text="Open" onAction="#openSimulation"/>
            <Button text="Delete" onAction="#deleteSimulation"/>
            <Button text="Load Sample Scenario" onAction="#loadSampleScenario"/>
        </HBox>
    </top>

    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">

            <!-- ==================== Screen 1: Dashboard ==================== -->
            <Tab text="Dashboard">
                <VBox spacing="16">
                    <padding>
                        <Insets top="18" right="22" bottom="18" left="22"/>
                    </padding>
                    <Label text="Dashboard" styleClass="view-title"/>
                    <GridPane hgap="12" vgap="12">
                        <columnConstraints>
                            <ColumnConstraints minWidth="260"/>
                            <ColumnConstraints minWidth="260"/>
                        </columnConstraints>
                        <HBox styleClass="stat" GridPane.rowIndex="0" GridPane.columnIndex="0">
                            <Label text="Total processes:"/>
                            <Label fx:id="totalProcessesValue" text="-" styleClass="stat-value"/>
                        </HBox>
                        <HBox styleClass="stat" GridPane.rowIndex="0" GridPane.columnIndex="1">
                            <Label text="Total resources:"/>
                            <Label fx:id="totalResourcesValue" text="-" styleClass="stat-value"/>
                        </HBox>
                        <HBox styleClass="stat" GridPane.rowIndex="1" GridPane.columnIndex="0">
                            <Label text="Available resources:"/>
                            <Label fx:id="availableResourcesValue" text="-" styleClass="stat-value"/>
                        </HBox>
                        <HBox styleClass="stat" GridPane.rowIndex="1" GridPane.columnIndex="1">
                            <Label text="Allocated resources:"/>
                            <Label fx:id="allocatedResourcesValue" text="-" styleClass="stat-value"/>
                        </HBox>
                        <HBox styleClass="stat" GridPane.rowIndex="2" GridPane.columnIndex="0" GridPane.columnSpan="2">
                            <Label text="Current deadlock status:"/>
                            <Label fx:id="deadlockStatusValue" text="-" styleClass="stat-value"/>
                        </HBox>
                    </GridPane>
                    <Label text="The deadlock status is checked live from the resource allocation graph."
                           styleClass="hint-label"/>
                </VBox>
            </Tab>

            <!-- ==================== Screen 2: Simulation ==================== -->
            <Tab text="Simulation">
                <VBox spacing="12">
                    <padding>
                        <Insets top="18" right="22" bottom="18" left="22"/>
                    </padding>
                    <HBox spacing="16">
                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                            <Label text="Processes" styleClass="section-title"/>
                            <HBox spacing="8">
                                <TextField fx:id="processNameField" promptText="e.g. P1" HBox.hgrow="ALWAYS"/>
                                <Button text="Add process" onAction="#addProcess"/>
                            </HBox>
                            <TableView fx:id="processTable" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="colProcessName" text="Name" prefWidth="80"/>
                                    <TableColumn fx:id="colProcessStatus" text="Status" prefWidth="100"/>
                                    <TableColumn fx:id="colProcessWaiting" text="Waiting for" prefWidth="120"/>
                                </columns>
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                </columnResizePolicy>
                            </TableView>
                            <HBox spacing="8">
                                <Button text="Terminate selected" onAction="#terminateSelectedProcess"/>
                                <Button text="Delete selected" onAction="#deleteSelectedProcess"/>
                            </HBox>
                        </VBox>
                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                            <Label text="Resources" styleClass="section-title"/>
                            <HBox spacing="8">
                                <TextField fx:id="resourceNameField" promptText="e.g. R1" HBox.hgrow="ALWAYS"/>
                                <Button text="Add resource" onAction="#addResource"/>
                            </HBox>
                            <TableView fx:id="resourceTable" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="colResourceName" text="Name" prefWidth="80"/>
                                    <TableColumn fx:id="colResourceStatus" text="Status" prefWidth="100"/>
                                    <TableColumn fx:id="colResourceHolder" text="Held by" prefWidth="120"/>
                                </columns>
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                </columnResizePolicy>
                            </TableView>
                            <HBox spacing="8">
                                <Button text="Delete selected" onAction="#deleteSelectedResource"/>
                            </HBox>
                        </VBox>
                    </HBox>
                    <HBox styleClass="form-row" spacing="10" alignment="CENTER_LEFT">
                        <Label text="Operate:" styleClass="section-title"/>
                        <ComboBox fx:id="processCombo" prefWidth="160"/>
                        <Label text="on"/>
                        <ComboBox fx:id="resourceCombo" prefWidth="160"/>
                        <Button text="Allocate" onAction="#allocate"/>
                        <Button text="Request" onAction="#request"/>
                        <Button text="Release" onAction="#release"/>
                    </HBox>
                    <Label text="Allocate = give the free resource to the process. Request = if it is taken, the process waits. Release = give it back."
                           styleClass="hint-label"/>
                </VBox>
            </Tab>

            <!-- ================= Screen 3: Deadlock Detection ================= -->
            <Tab text="Deadlock Detection">
                <VBox spacing="12">
                    <padding>
                        <Insets top="18" right="22" bottom="18" left="22"/>
                    </padding>
                    <HBox spacing="14" alignment="CENTER_LEFT">
                        <Button text="Detect Deadlock" onAction="#detectDeadlock"/>
                        <Label fx:id="deadlockResultLabel" text="Not checked yet" styleClass="status-chip"/>
                    </HBox>
                    <HBox spacing="16">
                        <ScrollPane styleClass="graph-scroll" fitToWidth="true">
                            <Canvas fx:id="graphCanvas" width="640" height="300"/>
                        </ScrollPane>
                        <VBox spacing="10">
                            <Label text="Graph edges" styleClass="section-title"/>
                            <TextArea fx:id="edgesArea" editable="false" wrapText="true"
                                      prefWidth="280" prefHeight="150"/>
                            <Label fx:id="involvedLabel" text="Deadlocked processes: -" wrapText="true"/>
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <ComboBox fx:id="deadlockedProcessCombo" prefWidth="130"/>
                                <Button fx:id="terminateInvolvedButton" text="Terminate Process"
                                        onAction="#terminateInvolvedProcess"/>
                            </HBox>
                            <Label fx:id="recoveryLabel" wrapText="true"/>
                            <Label fx:id="cycleLabel" styleClass="cycle-label" wrapText="true"/>
                        </VBox>
                    </HBox>
                    <Label text="Resource -> Process means allocated. Process -> Resource means waiting. A cycle in this graph is a deadlock."
                           styleClass="hint-label"/>
                </VBox>
            </Tab>

        </TabPane>
    </center>

</BorderPane>
